{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blue Ear",
  "version": "0.1.0",
  "identifier": "com.blueear.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "features": ["whisper"]
  },
  "app": {
    "windows": [
      {
        "title": "Blue Ear",
        "width": 420,
        "height": 640,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "media-src": "'self' asset: http://asset.localhost",
        "style-src": "'unsafe-inline' 'self'"
      },
      "devCsp": {
        "default-src": "'self' customprotocol: asset: http://localhost:1420 http://127.0.0.1:1420",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 http://127.0.0.1:1420 ws://localhost:1421 ws://127.0.0.1:1421",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "media-src": "'self' asset: http://asset.localhost",
        "style-src": "'unsafe-inline' 'self'",
        "script-src": "'self' 'unsafe-inline' http://localhost:1420 http://127.0.0.1:1420"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/Music/BlueEar/Recordings/**",
          "$MUSIC/BlueEar/Recordings/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.4",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true,
      "exceptionDomain": "",
      "frameworks": ["native/BlueEarAudio/.build/bundled/libBlueEarAudio.dylib"],
      "signingIdentity": "-",
      "providerShortName": null
    }
  }
}
